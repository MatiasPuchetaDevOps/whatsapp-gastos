# OpenAI Configuration
OPENAI_API_KEY=tu-api-key-aqui
OPENAI_MODEL=gpt-4.1-mini

# Google Sheets
SPREADSHEET_ID=tu-spreadsheet-id-aqui

# WhatsApp Groups → Sheets Mapping
# Cada grupo de WhatsApp escribe en una hoja diferente de la MISMA planilla
# Ejecuta `npm run buscar-grupos` para obtener los IDs de tus grupos
GROUP_DESTINATIONS_ID_1=tu-group-id-compartido@g.us
GROUP_DESTINATIONS_HOJA_1=Gastos
GROUP_DESTINATIONS_ID_2=tu-group-id-personal-matias@g.us
GROUP_DESTINATIONS_HOJA_2=Personal Matias
GROUP_DESTINATIONS_ID_3=tu-group-id-personal-pau@g.us
GROUP_DESTINATIONS_HOJA_3=Personal Pau

# Whitelist de números autorizados (separados por coma)
# Solo estos números pueden enviar mensajes al bot
WHITELIST_NUMBERS=5493543606194,5491234567890

# Celdas en la hoja "Resumen"
RESUMEN_BALANCE_CELL=B10
RESUMEN_GASTO_MES_CELL=B5

# Rutas y configuración
GOOGLE_CREDENTIALS_PATH=./google-credentials.json
AUTH_FOLDER=./auth_info

# Límites de montos
MONTO_MAXIMO=500000
MONTO_MINIMO=1

# Rate limiting (mensajes por minuto por usuario)
RATE_LIMIT_MENSAJES_POR_MINUTO=10

# Timeout para llamadas a OpenAI (en ms)
OPENAI_TIMEOUT_MS=15000
